#!/usr/bin/env python3
"""ddr -- the project's command surface: the oracle, the build, both gates, the diff.

Every routine step of the matching loop is one verb here, so a contributor (or an agent)
never has to remember which script, which config path or which order.  The verbs are thin
wrappers by design: ``configure.py`` owns the build graph, ``tools/verify/g1.py`` the
whole-file gate, ``tools/verify/g2.py`` the localisation, ``tools/iso/reinsert.py`` the disc
image, ``tools/oracle/*`` the artifacts, and ``tools/toolchain/check_deps.py`` the host
tools.  Nothing is re-implemented in this file; the one decision it makes is *which* of
those to call, in which order, and what to print.

Which *target* they work on is decided in exactly one place, ``config/targets.py``: the retail
ELF and its G1 pin, the disc image and its G3 pin, the config directory, the measured geometry
and the per-unit build pairs all come from the descriptor named by ``--target`` (default:
the target the tree is configured for).  ``--target`` is accepted before or after the verb.

    ./ddr oracle            regenerate the symbol/CU/chunk/header artifacts from the target's
                            retail ELF (deterministic: a fresh run reproduces what is
                            committed), applying its borrowed_symbols.txt -- the library
                            names tools/sdk/borrow.py validated against the corpora -- to
                            the symbol ledger
    ./ddr build             configure (manifests -> splat inputs -> build.ninja) then ninja
    ./ddr verify            G1: the target's orig/<elf> must be the pinned retail binary, and
                            its out/<elf> must equal it
    ./ddr verify --tu NAME  ... plus the per-TU verdict: its .text span, its .debug chunk
                            and its .line chunks against retail (the promotion rule)
    ./ddr verify --iso IMG  ... plus G3: the built ELF spliced back into a copy of IMG must
                            give IMG back, hash for hash
    ./ddr diff SYM TU       objdiff-cli between SYM's retail split and the C object the graph
                            compiles TU's source to (a unit with no C source is refused: it
                            has nothing to measure)
    ./ddr iso --iso IMG     G3 on its own

On a G1 failure the offset is localised through the oracle's manifests -- ``.debug``/``.line``
by G1's own chunk walk, a code byte by the DWARF function compile unit that covers it -- and
printed as one line naming the translation unit, the function and the compile unit (R32:
G2 consumes G1's localisation instead of deriving a second one).

Exit codes: 0 the verb's work succeeded and every gate it ran was green; 1 a gate or a TU
verdict failed, or a host tool is missing (``check_deps`` prints the remedy, never a
traceback); 2 a usage or configuration problem -- an unknown target, a target whose geometry
nobody has measured yet, a missing input, a name that matches no translation unit, an image
the ELF does not fit into, an image no record in the target's ``checksums.txt`` names
(``--allow-unpinned-reference`` is the opt-out), a unit with no C source to measure.
"""

from __future__ import annotations

import argparse
import pathlib
import subprocess
import sys

REPO_ROOT = pathlib.Path(__file__).resolve().parent
TOOLS = REPO_ROOT / "tools"
# `tools/oracle` is a flat module set (its own modules import each other by bare name), and
# `tools`/the repo root carry the namespace and `configure` respectively.
for extra in (str(TOOLS / "oracle"), str(TOOLS), str(REPO_ROOT)):
    if extra not in sys.path:
        sys.path.insert(0, extra)

import configure  # noqa: E402
import emit_chunks, emit_cus, emit_headers, emit_symbols  # noqa: E402
from config import targets  # noqa: E402  the descriptor every verb reads
from iso import reinsert  # noqa: E402
from toolchain import check_deps  # noqa: E402
from verify import g1, g2  # noqa: E402

#: The target a verb works on when ``--target`` names none.  Every path a verb touches --
#: the retail ELF, its pin, the manifests, the built image, the disc image and its pin --
#: is that target's own, resolved per invocation from `config.targets`; nothing in this file
#: spells a target name or a retail path.
DEFAULT = targets.DEFAULT
INCLUDE = REPO_ROOT / "include"
GRAPH = REPO_ROOT / "build.ninja"


def _target(args):
    """The target the parsed arguments name, or the default one.

    Raised as :class:`targets.UnknownTarget` for a name nothing defines, which :func:`main`
    turns into a usage error: a typo must not silently work on the default target.
    """
    return targets.get(getattr(args, "target", None))


def _display(path) -> str:
    """A path as a reader types it: repo-relative when it is inside the repo."""
    path = pathlib.Path(path)
    try:
        return str(path.relative_to(REPO_ROOT))
    except ValueError:
        return str(path)


def _ghidra(target):
    """The target's Ghidra function list, or None when it does not have one.

    A Ghidra list is an *optional* input: it exists to name the function starts the DWARF does
    not cover (an image whose DWARF is partial or absent), and a target whose DWARF covers its
    functions needs none -- the DWARF's own starts are then the whole ledger.  Resolved by
    existence, the way the borrowed-name ledger is: handing ``emit_symbols.build`` the path of
    a file that is not there would stop the oracle on the absence of something it does not
    need, which is what a retarget's first ``oracle`` run did.
    """
    return target.ghidra if target.ghidra.is_file() else None


def _require(*keys: str) -> None:
    """Probe the host tools by name, raising :class:`check_deps.MissingDependency`.

    With no keys this is every tool ``check_deps`` knows (``check_deps.require``); with keys
    it is exactly those, so ``build`` does not fail because a diff tool is missing and
    ``diff`` does not fail because a compiler is missing.
    """
    if not keys:
        check_deps.require()
    for key in keys:
        check_deps.version(check_deps.TOOLS_BY_KEY[key])


def _pin_mismatch(path, actual: str, pinned: str, what: str, target) -> str:
    """The loud line a gate prints when a pinned input is not the file it should be.

    Both digests in full, and the size: this is the failure -- a missing, truncated or
    wrong-version binary -- whose whole question is "what file is this really", and a gate
    that answered it with "the two inputs agree with each other" would be green over a
    corrupted tree.
    """
    size = pathlib.Path(path).stat().st_size
    return (f"{_display(path)} has sha256 {actual} ({size} bytes), but "
            f"{_display(target.checksums)} pins {pinned}: the {what} is missing, truncated or a "
            f"different version")


# ---------------------------------------------------------------------------
# oracle
# ---------------------------------------------------------------------------


def cmd_oracle(args) -> int:
    """Regenerate the four artifact families from the retail ELF, deterministically."""
    target = _target(args)
    retail = target.elf
    if not retail.is_file():
        print(f"ddr: {_display(retail)}: no such file: the oracle reads the retail ELF",
              file=sys.stderr)
        return 2
    geometry = target.geometry_required()  # the chunked sections' measured lengths
    cus = emit_cus.build(retail)
    emit_cus.write(target.cus, cus)
    print(f"oracle: {len(cus)} compile units -> {_display(target.cus)}")

    chunks = emit_chunks.build(target.cus, geometry.line_size, geometry.debug_size)
    emit_chunks.write(target.chunks, chunks)
    counts = {section: sum(1 for c in chunks if c["section"] == section)
              for section in (".debug", ".line")}
    print(f"oracle: {counts['.debug']} .debug + {counts['.line']} .line chunks "
          f"-> {_display(target.chunks)}")

    ghidra = _ghidra(target)  # an optional input: a target whose DWARF is complete has none
    records, borrowed = emit_symbols.apply_borrowed(
        emit_symbols.build(retail, ghidra), target.borrowed)
    placed, unplaced = emit_symbols.final(records, geometry)
    emit_symbols.write(target.symbols, placed)
    emit_symbols.write_unplaced(target.unplaced, unplaced)
    outside = [r for r in unplaced
               if r.get("reason") == emit_symbols.OUTSIDE_REASON]
    breakdown = f"{len(outside)} outside every declared segment, " if outside else ""
    print(f"oracle: {len(placed)} placed + {len(unplaced)} unplaced symbols "
          f"({breakdown}{borrowed} borrowed library names) -> {_display(target.symbols)}")
    if outside:
        addresses = {r["address"] for r in outside}
        print(f"oracle: {len(outside)} records over {len(addresses)} addresses are in no "
              f"segment this geometry declares (the zero-fill overlay reservations the yaml "
              f"does not model), so they are excluded from the split, not linked: "
              f"-> {_display(target.unplaced)}")
    if ghidra is None:
        print(f"oracle: {_display(target.ghidra)}: no Ghidra function list for this target, "
              f"so every symbol here is the DWARF's own")

    headers = emit_headers.write_all(retail, INCLUDE)
    print(f"oracle: {len(headers)} translation-unit headers -> {_display(INCLUDE)}")
    return 0


