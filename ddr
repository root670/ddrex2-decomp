def _refresh_status(target) -> int:
    """Regenerate README.md and docs/status.svg from the build this command just made.

    Called at the end of ``build`` -- after ninja's own ``g1`` edge has passed, when ``out/``
    is exactly the image the numbers describe -- and at the end of a plain ``verify``, so a
    promotion cannot leave either artifact stale.  ``status.py`` runs ``verify --tu`` for
    every candidate, which is why the call carries ``status.GATE_GUARD``: the gate must not
    call back into the generator that called it.  ``verify --tu`` itself does not refresh: it
    is the per-unit iteration command, not a whole-tree claim.
    """
    from units import status
    if os.environ.get(status.GATE_GUARD):
        return 0
    return status.main(["--target", target.name])


def cmd_build(args) -> int:
    """Configure, then build: exactly what a green ``verify`` needs to be possible."""
    target = _target(args)
    # The build's *actual* set: `configure.py` runs `python3 -m splat`, the graph runs
    # `as`/`ld`/`objcopy`, and `ninja` drives it.  `objdiff-cli` -- and the compiler --
    # are something else's prerequisite, not this verb's.  Host prerequisites first: a
    # missing tool is a remedy the reader can act on, whatever state the target is in.
    _require(*check_deps.BUILD_KEYS)
    if not target.elf.is_file():
        print(f"ddr: {_display(target.elf)}: no such file: the build needs the retail ELF",
              file=sys.stderr)
        return 2
    target.geometry_required()  # a target nobody has measured cannot be configured
    status = configure.main(["--target", target.name])
    if status != 0:
        return status
    ninja = check_deps.resolve(check_deps.TOOLS_BY_KEY["ninja"])
    result = subprocess.run([ninja], cwd=REPO_ROOT).returncode
    if result != 0:
        return result
    # ninja's default target is ``out/<elf> g1``: a successful run means the image the
    # numbers describe has just been compared with retail, so nothing here can read a stale
    # graph.
    return _refresh_status(target)


