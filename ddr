def _add_g3_arguments(parser, always: bool) -> None:
    """G3's three inputs: the image, the ELF spliced into it, and the copy it lands in."""
    parser.add_argument(
        "--iso", nargs="?", const="", default="" if always else None,
        help="the disc image to splice into; bare --iso means the target's mounted retail "
             "image, which is skipped (exit 0) rather than failed when it is absent")
    parser.add_argument("--elf", type=pathlib.Path, default=None,
                        help="the ELF to splice (default: the target's built image, "
                             "out/<elf>)")
    parser.add_argument("--out", type=pathlib.Path, default=reinsert.REBUILT_IMAGE,
                        help="where the rebuilt image goes (default: out/rebuilt.iso)")
    parser.add_argument(
        "--allow-unpinned-reference", action="store_true",
        help="compare the rebuild against the reference image itself when no record in "
             "checksums.txt names it (a test fixture, a stamp build): the criterion is then "
             "that file, not the disc, and the success line says so")


def _g3(args) -> int:
    """G3: splice ``--elf`` into a copy of ``--iso`` and compare the copy's digest.

    Every input is the *target's*: the image a bare ``--iso`` means, the ELF a bare
    ``--elf`` means, the ``checksums.txt`` the reference is resolved in, and the offset the
    splice lands at (measured from that target's own image).

    The *reference* is resolved in ``checksums.txt`` by file name first.  A record that
    names it pins it: the image must be the pinned file before it is allowed to be the
    expectation, so pointing the gate at a corrupted copy of the disc fails loudly instead
    of comparing the rebuild with the corruption.  An image no record names -- a test
    fixture, a stamp build -- has no criterion at all, and that is a hard failure: the
    reference's own digest as the expectation would let a renamed or tampered image pass by
    comparing the copy with itself.  ``--allow-unpinned-reference`` is the explicit opt-out;
    the criterion is then that file, and the success line says ``(UNPINNED)``.

    R30: the copy is written to the gitignored ``out/``, never to a temporary directory, and
    hashed streaming.
    """
    if args.iso is None:
        return 0
    target = _target(args)
    optional = args.iso == ""
    image = reinsert.retail_image(target) if optional else pathlib.Path(args.iso)
    if not image.is_file():
        if optional:
            print(f"G3 skipped (not a failure; nothing was compared): "
                  f"{_display(image)} is not mounted -- pass --iso IMG to run the gate")
            return 0
        print(f"ddr: {_display(image)}: no such file", file=sys.stderr)
        return 2
    elf = pathlib.Path(args.elf) if args.elf else target.built
    out = pathlib.Path(args.out)
    if not elf.is_file():
        print(f"ddr: {_display(elf)}: no such file (run ./ddr build)", file=sys.stderr)
        return 2
    # The pin is resolved by name and answered before the 1.24 GB hash: a reference no
    # record names has no criterion at all, and the reference's own digest as the
    # expectation would only let a renamed or tampered image pass by comparing the copy
    # with itself.
    pinned = g1.pinned_hash_for(image.name, target.checksums)
    if pinned is None and not args.allow_unpinned_reference:
        print(f"ddr: no record in {_display(target.checksums)} names {_display(image)}: G3 "
              f"has no pinned digest to check the rebuild against, and this file's own "
              f"digest would only compare the rebuild with itself.  Pass "
              f"--allow-unpinned-reference to use {image.name} itself as the criterion.",
              file=sys.stderr)
        return 2
    reference = reinsert.sha256(image)
    if pinned is not None and reference != pinned:
        print(f"G3 FAIL: {_pin_mismatch(image, reference, pinned, 'reference image', target)}")
        return 1
    print(f"G3: splicing {_display(elf)} into {_display(image)} -> {_display(out)}")
    try:
        reinsert.build(image, elf, out, reinsert.elf_offset(target))
    except ValueError as exc:
        print(f"ddr: {exc}", file=sys.stderr)
        return 2
    expected, actual = (pinned or reference), reinsert.sha256(out)
    if actual == expected:
        criterion = (f"equals the pinned digest of {image.name}" if pinned is not None else
                     "(UNPINNED) equals the reference image it was spliced into")
        print(f"G3 ok: {_display(out)} is {actual} ({image.stat().st_size} bytes, "
              f"{criterion})")
        return 0
    print(f"G3 FAIL: {reinsert.verify(out, expected, reference=image)}")
    return 1


def _unit_object(tu: str, tree=REPO_ROOT) -> pathlib.Path:
    """The object a promoted unit's ``cc`` edge writes: ``build/<file>.o``.

    Spelled the way ``configure.Promotion.object`` is (``build/<src>.o``) and the way the
    pinned linker script names it, so the check below compares the same path the link does.
    """
    return pathlib.Path(tree) / "build" / f"{tu}.o"


def _evidence_problems(tu: str, target, tree=REPO_ROOT, descriptor=None) -> list:
    """Why a verdict on ``tu`` would not be evidence about its source, or ``[]``.

    Two kinds, both configuration errors (exit 2) rather than verdicts, because a green line
    from either is a comparison that says nothing about any C:

    * **no source, no row** -- ``AGENTS.md`` rule 6: a source with no measured pair, or a row
      whose source is gone, is a configuration error.  A unit with neither is the same thing,
      and it was the one printing ``text ok`` for a path that names nothing.
    * **stale evidence** -- the source and the row both exist, but the built image the verdict
      reads was not produced from them.  ``out/`` must be newer than the unit's source, the
      descriptor its row lives in, and the unit's own object; that object must be newer than
      the source, must exist, and must be one the pinned linker script places.  Otherwise the
      ``.text`` in ``out/`` is the *split* (retail's own bytes), so ``text ok`` compares retail
      with retail -- the failure that reported ``model2`` and ``motion1`` green.

    ``tree`` and ``descriptor`` are the two paths the directory layout would otherwise decide;
    they are parameters so a test can point the same rule at a synthetic tree (the object lives
    under ``tree``; ``descriptor`` is the file ``tu_builds`` is written in).
    """
    tree = pathlib.Path(tree)
    descriptor = pathlib.Path(descriptor) if descriptor is not None else pathlib.Path(
        targets.__file__)
    source = tree / tu
    problems = []
    if not source.is_file():
        problems.append(f"no source at {tu} in this checkout")
    if target.build_pair(tu) is None:
        problems.append(f"no measured compiler pair in {target.name}'s tu_builds")
    if problems:
        return problems
    obj = _unit_object(tu, tree)
    if not obj.is_file():
        return [f"its object {_display(obj)} is missing"]
    script = target.ld_script
    if not script.is_file() or obj.relative_to(tree).as_posix() not in script.read_text():
        return [f"{_display(obj)} is not one of the link's inputs ({_display(script)} does not "
                f"name it): the graph predates its row"]
    if obj.stat().st_mtime_ns < source.stat().st_mtime_ns:
        return [f"its object {_display(obj)} is older than its source {tu}"]
    out = target.built
    if not out.is_file():
        return [f"{_display(out)} is missing"]
    stamps = (("its source", source),
              ("its measured pair", descriptor),
              ("its object", obj))
    return [f"{_display(out)} is older than {label} {_display(path)}"
            for label, path in stamps
            if path.stat().st_mtime_ns > out.stat().st_mtime_ns]


def _tu_report(built, retail, name, target) -> int:
    """``verify --tu``: the per-TU verdict, one line per thing the promotion rule needs.

    The unit has to be *promotable and current* before its bytes are compared, and that is
    checked first: three green lines from a stale ``out/`` or from a unit with no source are
    the false evidence that gets a unit reported as satisfied.  A configuration error exits 2
    naming what is missing or stale and what to run; only then are the three verdicts taken
    and printed, and their exit code is 0 (all three ok) or 1 (one of them failed).
    """
    manifests = g2.Manifests(target.cus, target.chunks, target.symbols)
    try:
        tu = manifests.tu_named(name)
    except g2.UnknownUnit as exc:
        # A name that matches no unit is a usage error, answered before anything is compared.
        print(f"ddr: {exc}", file=sys.stderr)
        return 2
    problems = _evidence_problems(tu, target)
    if problems:
        print(f"ddr: {tu}: {'; '.join(problems)}: the bytes in {_display(built)} say nothing "
              f"about this unit's source -- run ./ddr build, then verify again",
              file=sys.stderr)
        return 2
    try:
        tu, report = g2.verdicts(built, retail, name, target.cus, target.chunks,
                                 target.symbols, target.geometry_required(),
                                 image=target.image)
    except (g2.UnknownUnit, targets.OutsideLoadableImage, KeyError, ValueError, OSError,
            FileNotFoundError) as exc:
        # An address the retail ELF maps no bytes at, a module the geometry does not record,
        # a missing manifest: configuration problems, named rather than a traceback.
        print(f"ddr: {exc}", file=sys.stderr)
        return 2
    for verdict in report:
        print(f"{tu}: {verdict.what} {'ok' if verdict.ok else 'FAIL'} ({verdict.detail})")
    return 0 if all(verdict.ok for verdict in report) else 1


def cmd_verify(args) -> int:
    target = _target(args)
    built = target.built
    retail = pathlib.Path(args.retail) if args.retail else target.elf
    if not built.is_file():
        print(f"ddr: {_display(built)}: no such file (run ./ddr build)", file=sys.stderr)
        return 2
    if not retail.is_file():
        print(f"ddr: {_display(retail)}: no such file: G1 needs the retail binary",
              file=sys.stderr)
        return 2
    if args.tu is not None:
        # A name that matches no translation unit is a usage error, and it is answered
        # before G1 runs: a half-printed gate next to a bad argument helps nobody.
        try:
            g2.Manifests(target.cus, target.chunks, target.symbols).tu_named(args.tu)
        except g2.UnknownUnit as exc:
            print(f"ddr: {exc}", file=sys.stderr)
            return 2
    # The pin first, and on its own: G1 compares two files, so a truncated, substituted or
    # wrong-version retail binary that happens to agree with the build would compare "ok".
    # The absolute criterion of the design -- and of g1.py's own CLI -- is the pinned digest,
    # not the agreement of the pair.
    pinned = g1.pinned_hash(target.checksums)
    actual = g1.sha256(retail)
    if pinned is not None and actual != pinned:
        print(f"G1 FAIL: {_pin_mismatch(retail, actual, pinned, 'retail binary', target)}")
        return 1
    status = 0
    geometry = target.geometry_required()
    message = g1.compare(built, retail, target.cus, target.chunks, geometry)
    if message == "ok":
        print(f"G1 ok: {_display(built)} is {g1.sha256(built)}")
    else:
        located = g2.localise(built, retail, target.cus, target.chunks, target.symbols,
                              geometry)
        print(f"G1 FAIL: {g2.describe(located) or message}")
        if located is not None:
            print(f"         {message}")
        status = 1
    if args.tu is not None:
        # The verdict is printed even when G1 is red: a promoted translation unit is
        # iterated with it, and "which chunk" is the question at that point.
        status = max(status, _tu_report(built, retail, args.tu, target))
    status = max(status, _g3(args))
    if args.tu is not None:
        # Per-unit iteration, not a whole-tree claim: leave the artifacts to build/verify.
        return status
    # ``out/`` is the image this run just judged, so the two generated artifacts can be
    # brought current from it; status.py's own ``verify --tu`` calls carry GATE_GUARD.
    return max(status, _refresh_status(target))


def cmd_iso(args) -> int:
    """G3 alone -- ``verify --iso`` without re-running G1 over the same image."""
    return _g3(args)


