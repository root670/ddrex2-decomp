#: The target a verb works on when ``--target`` names none.  Every path a verb touches --
#: the retail ELF, its pin, the manifests, the built image, the disc image and its pin --
#: is that target's own, resolved per invocation from `config.targets`; nothing in this file
#: spells a target name or a retail path.
DEFAULT = targets.DEFAULT
INCLUDE = REPO_ROOT / "include"
GRAPH = REPO_ROOT / "build.ninja"


def _target(args):
    """The target the parsed arguments name, or the default one.

    Raised as :class:`targets.UnknownTarget` for a name nothing defines, which :func:`main`
    turns into a usage error: a typo must not silently work on the default target.
    """
    return targets.get(getattr(args, "target", None))


def _display(path) -> str:
    """A path as a reader types it: repo-relative when it is inside the repo."""
    path = pathlib.Path(path)
    try:
        return str(path.relative_to(REPO_ROOT))
    except ValueError:
        return str(path)


def _ghidra(target):
    """The target's Ghidra function list, or None when it does not have one.

    A Ghidra list is an *optional* input: it exists to name the function starts the DWARF does
    not cover (an image whose DWARF is partial or absent), and a target whose DWARF covers its
    functions needs none -- the DWARF's own starts are then the whole ledger.  Resolved by
    existence, the way the borrowed-name ledger is: handing ``emit_symbols.build`` the path of
    a file that is not there would stop the oracle on the absence of something it does not
    need, which is what a retarget's first ``oracle`` run did.
    """
    return target.ghidra if target.ghidra.is_file() else None


def _require(*keys: str) -> None:
    """Probe the host tools by name, raising :class:`check_deps.MissingDependency`.

    With no keys this is every tool ``check_deps`` knows (``check_deps.require``); with keys
    it is exactly those, so ``build`` does not fail because a diff tool is missing and
    ``diff`` does not fail because a compiler is missing.
    """
    if not keys:
        check_deps.require()
    for key in keys:
        check_deps.version(check_deps.TOOLS_BY_KEY[key])


def _pin_mismatch(path, actual: str, pinned: str, what: str, target) -> str:
    """The loud line a gate prints when a pinned input is not the file it should be.

    Both digests in full, and the size: this is the failure -- a missing, truncated or
    wrong-version binary -- whose whole question is "what file is this really", and a gate
    that answered it with "the two inputs agree with each other" would be green over a
    corrupted tree.
    """
    size = pathlib.Path(path).stat().st_size
    return (f"{_display(path)} has sha256 {actual} ({size} bytes), but "
            f"{_display(target.checksums)} pins {pinned}: the {what} is missing, truncated or a "
            f"different version")


