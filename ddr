def _add_target_argument(parser, suppressed: bool = False) -> None:
    """``--target NAME``: which decompilation target this invocation works on.

    On the main parser *and* on every verb, so both spellings the plan uses work --
    ``ddr --target <name> verify`` and ``ddr verify --target <name>`` -- and the default keeps
    today's behaviour (the target the tree is configured for).  The verbs' own declaration is
    ``SUPPRESS``ed as a default because argparse copies a subparser's whole namespace up into
    the parent's: a plain ``default=None`` there would overwrite a ``--target`` given *before*
    the verb with None and silently fall back to the default target.
    """
    parser.add_argument(
        "--target", default=argparse.SUPPRESS if suppressed else None, metavar="NAME",
        help=f"the decompilation target to work on (default: {DEFAULT}; known: "
             f"{', '.join(targets.names())})")


def _verb(verbs, name, help):
    """A verb's parser, with ``--target`` accepted after the verb name too."""
    parser = verbs.add_parser(name, help=help)
    _add_target_argument(parser, suppressed=True)
    return parser


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="ddr", description=__doc__.splitlines()[0])
    _add_target_argument(parser)
    verbs = parser.add_subparsers(dest="verb", required=True)

    _verb(verbs, "oracle", "regenerate the symbol/CU/chunk/header artifacts"
          ).set_defaults(func=cmd_oracle)
    _verb(verbs, "build", "configure and build the target's out/<elf>"
          ).set_defaults(func=cmd_build)

    verify = _verb(verbs, "verify", "G1, plus the TU verdict and/or G3")
    verify.add_argument("--tu", default=None,
                        help="report one translation unit (name, file or repo path)")
    verify.add_argument("--retail", default=None,
                        help="the retail binary to pin-check and compare against "
                             "(default: the target's own retail ELF)")
    _add_g3_arguments(verify, always=False)
    verify.set_defaults(func=cmd_verify)

    diff = _verb(verbs, "diff", "objdiff-cli for one symbol in one translation unit")
    diff.add_argument("symbol", help="the function to diff (a name from symbol_addrs.txt)")
    diff.add_argument("tu", help="the translation unit that must own it (sys_scf or sys_scf.c)")
    diff.add_argument("--base", type=pathlib.Path, default=None,
                      help="the object to diff against (default: the TU's own C object from "
                           "the build graph, else our own bytes for the symbol out of its "
                           "split -- and objdiff-cli is only believed when it reports a "
                           "percentage for the symbol on both sides)")
    diff.set_defaults(func=cmd_diff)

    iso = _verb(verbs, "iso", "G3: splice the built ELF back into the image")
    _add_g3_arguments(iso, always=True)
    iso.set_defaults(func=cmd_iso)
    return parser.parse_args(argv)


def main(argv=None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        return args.func(args)
    except check_deps.MissingDependency as exc:
        # Never a traceback: the message already names what is missing and the command
        # that provides it.
        print(f"ddr: {exc}", file=sys.stderr)
        return 1
    except (targets.UnknownTarget, targets.NotMeasured) as exc:
        # A target nobody defined, or one whose geometry has not been measured: a usage or
        # configuration problem (exit 2), never a traceback.
        print(f"ddr: {exc}", file=sys.stderr)
        return 2
    except configure.ConfigError as exc:
        print(f"ddr: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
