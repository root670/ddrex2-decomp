def _split_object(symbol: str, target):
    """The split object splat's graph builds for ``symbol``: our bytes for it, as assembly.

    The path mirrors splat's own naming (``configure.object_path``) under the target's code
    segment.  It is not a diff side any more -- objdiff scores no split as-is, because the
    ``.NON_MATCHING`` alias splat writes into it makes every symbol of that name ignored --
    but it is where the *base* of an unpromoted unit's diff comes from (``basis.split``).
    """
    split = (REPO_ROOT / "asm" / "nonmatchings" / target.geometry_required().code_segment
             / f"{symbol}.s")
    return configure.object_path(split)


def _promoted_object(tu: str):
    """The object ninja compiles ``tu``'s C source to, once configure.py writes that edge.

    The build graph is read instead of a path convention being assumed: ``configure.py``
    owns where an object lands (Task 12 makes a promoted TU a ``cc`` edge), and this is the
    one place the CLI lets the graph speak for itself.  A generated edge also declares the
    files that produce it as *implicit* inputs (``|``, R35a), which ninja keeps out of
    ``$in``: only the explicit inputs are the source the command is handed.
    """
    if not GRAPH.is_file():
        return None
    for line in GRAPH.read_text().splitlines():
        if ": cc " not in line:
            continue
        output, _, inputs = line.strip().removeprefix("build ").partition(": cc ")
        source = inputs.split("|", 1)[0].strip()
        if source == tu:
            return REPO_ROOT / output.strip()
    return None


def _diff_base(args, symbol: str, tu: str, target):
    """``(path, what)`` -- the base side of the diff and the words that name it, or None.

    The base is the object under edit: the one ``--base`` names, else the object the graph
    compiles ``tu``'s source to, else -- a unit with no C -- the split's own bytes for
    ``symbol``, emitted under the plain name (``basis.split``) because a split object as it
    stands is one objdiff refuses to score at all.  ``what`` is printed with the diff so no
    reader can take a retail-bytes target for the split, or the split for a C object.
    """
    if args.base is not None:
        return pathlib.Path(args.base), "the object you named"
    if not GRAPH.is_file():
        print(f"ddr: {_display(GRAPH)}: no such file (run ./ddr build)", file=sys.stderr)
        return None
    promoted = _promoted_object(tu)
    if promoted is not None:
        return promoted, f"the C object the graph compiles {tu} to"
    split = _split_object(symbol, target)
    if not split.is_file():
        print(f"ddr: {_display(split)}: no such object (run ./ddr build)", file=sys.stderr)
        return None
    try:
        return (diff_basis.split(symbol, split),
                f"our build's own bytes for {symbol} out of {_display(split)}: {tu} has no "
                f"object in the build graph, and a split object is not scorable as it stands")
    except diff_basis.Unusable as exc:
        print(f"ddr: {exc}", file=sys.stderr)
        return None


def cmd_diff(args) -> int:
    """objdiff-cli for one symbol: the retail bytes for it against the object under edit."""
    target = _target(args)
    manifests = g2.Manifests(target.cus, target.chunks, target.symbols)
    try:
        tu = manifests.tu_named(args.tu)
    except g2.UnknownUnit as exc:
        print(f"ddr: {exc}", file=sys.stderr)
        return 2
    address = next((addr for addr, name in g1._symbol_table(target.symbols).items()
                    if name == args.symbol), None)
    if address is None:
        print(f"ddr: no symbol named {args.symbol!r} in {_display(target.symbols)}",
              file=sys.stderr)
        return 2
    owner = manifests.record_at_pc(address)
    if owner is None or owner.get("file") != tu:
        where = f"{owner['file']}:{manifests.symbol_at(owner['low_pc'])}" if owner else "?"
        print(f"ddr: {args.symbol} is at 0x{address:08X} in {where}, not {tu}",
              file=sys.stderr)
        return 2
    size = owner["high_pc"] - owner["low_pc"]
    if not target.elf.is_file():
        print(f"ddr: {_display(target.elf)}: no such file: the target side of the diff is "
              f"the retail bytes of {args.symbol}", file=sys.stderr)
        return 2
    # The base first: a refusal here must not leave an emitted object behind.
    resolved = _diff_base(args, args.symbol, tu, target)
    if resolved is None:
        return 2
    base, what = resolved
    if not base.is_file():
        hint = "" if args.base is not None else " (run ./ddr build)"
        print(f"ddr: {_display(base)}: no such object{hint}", file=sys.stderr)
        return 2
    _require("objdiff")
    objdiff = check_deps.resolve(check_deps.TOOLS_BY_KEY["objdiff"])
    try:
        # The target side is retail's own bytes for this function, emitted under its name --
        # *not* the split, whose unresolved call targets would depress the score of a
        # legitimately identical function by an artefact of how it spells a relocation.
        retail_object = diff_basis.retail(args.symbol, address, size, target.elf)
    except (diff_basis.Unusable, KeyError, ValueError) as exc:
        print(f"ddr: {exc}", file=sys.stderr)
        return 2
    # stdout stays pure objdiff JSON so it can be redirected or uploaded; what was compared
    # goes to stderr, where a human reads it and a pipeline ignores it.
    print(f"diff: {args.symbol} ({tu}) at VA 0x{address:08X} [{target.name}]\n"
          f"      target {_display(retail_object)} (the retail bytes of {args.symbol}, "
          f"{size} bytes read from {_display(target.elf)})\n"
          f"      base   {_display(base)} ({what})", file=sys.stderr)
    argv = [objdiff, "diff", args.symbol, "-1", str(retail_object), "-2", str(base),
            "-o", "-"]
    done = subprocess.run(argv, cwd=REPO_ROOT, capture_output=True, text=True)
    if done.stderr:
        sys.stderr.write(done.stderr)                 # objdiff's own warnings, kept visible
    if done.returncode != 0:
        sys.stdout.write(done.stdout)
        return done.returncode
    # A percentage is printed only for a comparison objdiff actually made: a report that
    # pairs the symbol with nothing (the base object does not define it, say) carries the
    # symbols but no `match_percent`, and its section-level arithmetic is not a score for
    # this function.
    try:
        report = json.loads(done.stdout)
    except json.JSONDecodeError:
        report = None
    if report is None or not diff_basis.scored(report, args.symbol):
        print(f"ddr: objdiff-cli compared nothing for {args.symbol}: {_display(base)} holds no "
              f"symbol of that name with a percentage to report, so there is no score to "
              f"print.  Pass --base PATH with the object you built for it.",
              file=sys.stderr)
        return 2
    sys.stdout.write(done.stdout)
    return 0


