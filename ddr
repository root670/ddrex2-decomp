def cmd_oracle(args) -> int:
    """Regenerate the four artifact families from the retail ELF, deterministically."""
    target = _target(args)
    retail = target.elf
    if not retail.is_file():
        print(f"ddr: {_display(retail)}: no such file: the oracle reads the retail ELF",
              file=sys.stderr)
        return 2
    geometry = target.geometry_required()  # the chunked sections' measured lengths
    cus = emit_cus.build(retail)
    emit_cus.write(target.cus, cus)
    print(f"oracle: {len(cus)} compile units -> {_display(target.cus)}")

    chunks = emit_chunks.build(target.cus, geometry.line_size, geometry.debug_size)
    emit_chunks.write(target.chunks, chunks)
    counts = {section: sum(1 for c in chunks if c["section"] == section)
              for section in (".debug", ".line")}
    print(f"oracle: {counts['.debug']} .debug + {counts['.line']} .line chunks "
          f"-> {_display(target.chunks)}")

    ghidra = _ghidra(target)  # an optional input: a target whose DWARF is complete has none
    records, borrowed = emit_symbols.apply_borrowed(
        emit_symbols.build(retail, ghidra), target.borrowed)
    placed, unplaced = emit_symbols.final(records, geometry)
    emit_symbols.write(target.symbols, placed)
    emit_symbols.write_unplaced(target.unplaced, unplaced)
    outside = [r for r in unplaced
               if r.get("reason") == emit_symbols.OUTSIDE_REASON]
    breakdown = f"{len(outside)} outside every declared segment, " if outside else ""
    print(f"oracle: {len(placed)} placed + {len(unplaced)} unplaced symbols "
          f"({breakdown}{borrowed} borrowed library names) -> {_display(target.symbols)}")
    if outside:
        addresses = {r["address"] for r in outside}
        print(f"oracle: {len(outside)} records over {len(addresses)} addresses are in no "
              f"segment the yaml declares (the overlay windows the geometry records "
              f"separately), so they are excluded from the split, not linked, and each one's "
              f"module is recorded with it: -> {_display(target.unplaced)}")
    if ghidra is None:
        print(f"oracle: {_display(target.ghidra)}: no Ghidra function list for this target, "
              f"so every symbol here is the DWARF's own")

    headers = emit_headers.write_all(retail, INCLUDE)
    print(f"oracle: {len(headers)} translation-unit headers -> {_display(INCLUDE)}")
    return 0


